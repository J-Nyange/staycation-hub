{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "env": {
    "VITE_SUPABASE_URL": "@supabase_url",
    "VITE_SUPABASE_ANON_KEY": "@supabase_anon_key"
  },
  "routes": [
    { "src": "/index.html", "status": 200 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
